{
  "name": "fortitude",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-agent social simulation aboard a dying ring station",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli/serve.ts",
    "sim": "tsx src/cli/sim.ts",
    "agent": "tsx src/cli/agent.ts",
    "replay": "tsx src/cli/replay.ts",
    "turns": "tsx src/cli/turns.ts",
    "alita": "tsx src/cli/alita.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
