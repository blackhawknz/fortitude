# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter, LM Studio, Ollama /v1, ...)
FORTITUDE_LLM_BASE_URL=https://api.deepseek.com/v1
FORTITUDE_LLM_API_KEY=
FORTITUDE_LLM_MODEL=deepseek-chat
# Request timeout for one agent turn (ms)
FORTITUDE_LLM_TIMEOUT_MS=45000

# SQLite file for the world database
FORTITUDE_DB=data/fortitude.db

# The Alita system (the Queen's memory and voice). Unset = the Queen runs on the local model.
# If Alita is down, Fortitude falls back automatically and reconciles her memories later.
ALITA_URL=http://127.0.0.1:8080
# Only if ALITA_API_TOKEN is set on the Alita backend
ALITA_API_TOKEN=
ALITA_TIMEOUT_MS=30000
# After a failure, wait this long before trying Alita again
ALITA_COOLDOWN_MS=30000

# The player's web UI (npm start). Loopback only.
FORTITUDE_PORT=4100
# Optional: require a bearer token for the API
FORTITUDE_TOKEN=
# Name for the player's character in NEW worlds (or --name)
FORTITUDE_PLAYER_NAME=Ash

# Teasers while you're away: always in-app; also POSTed here if set (ntfy / Discord / Slack-style webhook)
FORTITUDE_TEASER_WEBHOOK=
FORTITUDE_TEASER_AFTER_MS=7200000
FORTITUDE_TEASER_COOLDOWN_MS=21600000
